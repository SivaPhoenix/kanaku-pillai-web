# Copy to .env.local for local development. Vite exposes only VITE_* keys to the browser, so never put secrets here.

# Google OAuth Web client ID (public, not secret). Must match one of the backend's GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=

# Where the dev server proxies /api (the backend). The browser always calls same-origin /api/v1.
VITE_API_PROXY_TARGET=http://localhost:4000
